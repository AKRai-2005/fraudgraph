# ---- TigerGraph (Savanna cloud workspace) ----
# From savanna.tgcloud.io -> your workspace -> Connect
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=
# Optional: a graph secret instead of user/password
TG_SECRET=
TG_REST_PORT=443
TG_GS_PORT=443
TG_USE_TLS=true

# ---- LLM (Google Gemini free tier: https://aistudio.google.com/apikey) ----
FG_LLM_PROVIDER=gemini
FG_LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# ---- Runtime ----
# auto | tigergraph | local
FG_GRAPH_BACKEND=auto
FG_RAW_DIR=
FG_API_PORT=8077
