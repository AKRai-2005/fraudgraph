# ---------------------------------------------------------------------------
# Copy to .env and fill in. See README.md -> Connecting TigerGraph.
# This file is gitignored; never commit it.
# ---------------------------------------------------------------------------

# ---- TigerGraph Savanna --------------------------------------------------
# 1. TG_HOST: Savanna -> Workspaces -> click your workspace -> copy its URL.
#    Looks like  https://abcd1234.i.tgcloud.io
TG_HOST=

# 2. TG_SECRET: Savanna -> Database Secrets (left nav) -> Create Secret.
#    Pick the workspace above. Copy it immediately -- it is shown only once.
#    Savanna authenticates tools with a secret, NOT a password.
TG_SECRET=

TG_GRAPH=FraudInvestigation
TG_REST_PORT=443
TG_GS_PORT=443
TG_USE_TLS=true

# Only for a self-hosted Community Edition install; leave blank for Savanna.
TG_USERNAME=tigergraph
TG_PASSWORD=

# ---- Gemini --------------------------------------------------------------
# 3. Free key from https://aistudio.google.com/apikey
FG_LLM_PROVIDER=gemini
FG_LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=

# ---- Runtime -------------------------------------------------------------
# auto | tigergraph | mcp | local
# leave on "auto" until the graph is loaded; it falls back to the local mirror
FG_GRAPH_BACKEND=auto
FG_API_PORT=8077
