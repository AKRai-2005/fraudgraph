/* Loading jobs. One file per vertex/edge set, produced by
 * `python -m fraudgraph.ingest.tg_export` into build/tg_csv/.
 *
 * Idempotent: TigerGraph upserts by primary id, so re-running a job updates
 * rather than duplicates.  That is what makes ingestion repeatable.
 */

CREATE LOADING JOB load_fraud_graph FOR GRAPH FraudInvestigation {
  DEFINE FILENAME f_customer;
  DEFINE FILENAME f_card;
  DEFINE FILENAME f_txn;
  DEFINE FILENAME f_device;
  DEFINE FILENAME f_region;
  DEFINE FILENAME f_email;
  DEFINE FILENAME f_closed_case;
  DEFINE FILENAME f_pattern;
  DEFINE FILENAME f_policy;
  DEFINE FILENAME f_edge_next;
  DEFINE FILENAME f_edge_case_txn;
  DEFINE FILENAME f_edge_case_conn;

  LOAD f_customer TO VERTEX Customer VALUES(
    $"customer_id", $"n_cards", $"n_txns", $"first_ts", $"last_ts",
    $"total_amt", $"home_region", $"home_country"
  ) USING header="true", separator=",";

  LOAD f_card TO VERTEX Card VALUES(
    $"card_id", $"customer_id", $"card1", $"network", $"card_type", $"n_txns",
    $"first_ts", $"last_ts", $"total_amt", $"median_amt", $"max_amt",
    $"n_online", $"n_in_person", $"mean_risk"
  ), TO EDGE OWNS VALUES($"customer_id", $"card_id")
  USING header="true", separator=",";

  LOAD f_txn TO VERTEX Transaction VALUES(
    $"txn_id", $"card_id", $"customer_id", $"ts", $"amount", $"product_cd",
    $"channel", $"risk_score", $"addr1", $"addr2", $"dist1", $"p_email",
    $"r_email", $"device_profile", $"device_new", $"proxy_flag",
    $"match_status", $"seq_in_card"
  ),
  TO EDGE MADE VALUES($"card_id", $"txn_id", $"ts", $"amount"),
  TO EDGE FROM_DEVICE VALUES($"txn_id", $"device_profile", $"device_new", $"proxy_flag")
      WHERE $"device_profile" != "",
  TO EDGE BILLED_IN VALUES($"txn_id", $"addr1") WHERE $"addr1" != "",
  TO EDGE PURCHASER_EMAIL VALUES($"txn_id", $"p_email") WHERE $"p_email" != "",
  TO EDGE RECIPIENT_EMAIL VALUES($"txn_id", $"r_email") WHERE $"r_email" != ""
  USING header="true", separator=",";

  LOAD f_device TO VERTEX DeviceProfile VALUES(
    $"device_profile", $"device_type", $"device_info", $"os", $"browser",
    $"screen", $"proxy_flags", $"n_txns", $"n_cards", $"n_customers",
    $"n_new_for_account", $"first_ts", $"last_ts", $"total_amt"
  ) USING header="true", separator=",";

  LOAD f_region TO VERTEX BillingRegion VALUES(
    $"region_id", $"country", $"n_txns", $"n_cards", $"n_customers"
  ) USING header="true", separator=",";

  LOAD f_email TO VERTEX EmailDomain VALUES($"domain", $"n_txns")
  USING header="true", separator=",";

  LOAD f_closed_case TO VERTEX ClosedCase VALUES(
    $"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at",
    $"outcome", $"pattern", $"first_fraud_txn_id", $"n_txns", $"exposure_usd",
    $"actions_taken", $"report_filed", $"analyst_notes"
  ), TO EDGE ON_CARD VALUES($"case_id", $"card_id")
  USING header="true", separator=",", quote="double";

  LOAD f_pattern TO VERTEX FraudPattern VALUES(
    $"pattern_id", $"name", $"description", $"documented", $"policy_rules"
  ) USING header="true", separator=",", quote="double";

  LOAD f_policy TO VERTEX PolicyRule VALUES($"rule_id", $"summary", $"rule_text")
  USING header="true", separator=",", quote="double";

  LOAD f_edge_next TO EDGE NEXT_TXN VALUES($"from_txn", $"to_txn", $"gap_s")
  USING header="true", separator=",";

  LOAD f_edge_case_txn TO EDGE INVOLVES VALUES($"case_id", $"txn_id")
  USING header="true", separator=",";

  LOAD f_edge_case_conn TO EDGE CONNECTED_TO VALUES($"case_id", $"card_id")
  USING header="true", separator=",";
}
